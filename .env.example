# Скопируйте в .env и заполните.
# На Railway эти переменные задаются во вкладке Variables сервиса.

# Postgres. На Railway подставляется автоматически, если добавить
# в проект базу: + New → Database → PostgreSQL, затем в сервисе
# указать ссылку на переменную: ${{ Postgres.DATABASE_URL }}
DATABASE_URL="postgresql://user@localhost:5432/ligacord_dev?schema=public"

# Секрет для подписи сессионных cookie. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Ключ Anthropic. Без него подбор и КП работают на демо-заглушках.
# Получить: https://console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=""

# Необязательно: модель. По умолчанию claude-sonnet-5 (дешевле).
# Умнее, но дороже: claude-opus-5
# LIGACORD_MODEL="claude-sonnet-5"

# Необязательно: суточные лимиты платных AI-запросов.
# Гость — пробные запросы до регистрации; пользователь — потолок в сутки.
# AI_GUEST_DAILY_LIMIT=2
# AI_USER_DAILY_LIMIT=30
