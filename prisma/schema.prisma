// Cord data model.
// Company has many Listings (one company can post several barter offers).
// Catalog is public; contacts are gated behind auth in the app layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  // Stored normalized to E.164 (+998XXXXXXXXX) so lookups are unambiguous.
  phone        String   @unique
  passwordHash String
  // Optional and private: used only to notify about new messages. Never shown
  // to other users — the public contact lives on Company.contact.
  email        String?
  createdAt    DateTime @default(now())

  company Company?
}

model Company {
  id       String  @id @default(cuid())
  // Demo/seed companies have no owner — that's why userId is optional.
  userId   String? @unique
  user     User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  about    String  @default("")
  category String  @default("other")
  contact  String  @default("")
  // Marks the seeded example companies so the UI can label them honestly.
  isDemo   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings Listing[]

  startedConversations  Conversation[] @relation("ConversationInitiator")
  receivedConversations Conversation[] @relation("ConversationOwner")
  sentMessages          Message[]      @relation("MessageSender")

  @@index([category])
  @@index([isDemo])
}

// Daily counter for paid AI calls, so an open endpoint can't drain the API
// budget. Keyed by "user:<id>" for signed-in users and "ip:<sha256>" for guests
// — the IP is hashed, never stored raw, since it is personal data.
model AiUsage {
  id    String @id @default(cuid())
  key   String
  day   String // YYYY-MM-DD (UTC)
  count Int    @default(0)

  @@unique([key, day])
  @@index([day])
}

model Listing {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title    String
  // The two halves of the deal.
  gives    String
  seeks    String
  category String  @default("other")

  // What kind of partnership is on offer: barter / sponsorship / cross_promo /
  // affiliate / distribution / referral. See lib/partnershipTypes.js.
  partnershipType String @default("barter")

  // Optional deal details from the form.
  budget String @default("")
  venue  String @default("")

  // Offer deadline. null = open-ended. Once it passes the listing drops out of
  // the public catalog and AI matching, but stays visible to its owner so they
  // can extend it rather than lose it silently.
  expiresAt DateTime?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations Conversation[]

  @@index([category])
  @@index([partnershipType])
  @@index([isActive, createdAt])
  @@index([expiresAt])
}

// A negotiation about one specific listing, between the company that owns it
// and the company that reached out. Tying it to a listing (rather than just to
// a company pair) keeps the context of what is being negotiated.
model Conversation {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // The company that started the conversation.
  initiatorId String
  initiator   Company @relation("ConversationInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  // The company that owns the listing.
  ownerId String
  owner   Company @relation("ConversationOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  messages Message[]

  // One thread per listing per initiator — a second "Написать" click reopens
  // the existing conversation instead of starting a duplicate.
  @@unique([listingId, initiatorId])
  @@index([ownerId, lastMessageAt])
  @@index([initiatorId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Which side wrote it. Always one of the conversation's two companies.
  senderId String
  sender   Company @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  body      String
  // Null until the other side opens the thread.
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([conversationId, createdAt])
}
